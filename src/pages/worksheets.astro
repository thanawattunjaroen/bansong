import Layout from '../layouts/Layout.astro';
---
<Layout title="ใบงาน" active="worksheets"><div class="container page"><div class="breadcrumb"><a href="/">หน้าแรก</a> / ใบงาน</div><div class="page-heading"><span class="eyebrow">LEARN BY DOING</span><h1>ใบงานและไฟล์ฝึกปฏิบัติ</h1><p>พื้นที่รวมไฟล์ประกอบบทเรียน แยกตามชั้นเรียน</p></div><div class="grade-grid">{[4,5].map(g=><section class="worksheet-card"><span class="grade-number">ป.{g}</span><h2>ใบงานชั้นประถมศึกษาปีที่ {g}</h2><p>กำลังเตรียมใบงาน Word และ PDF</p><p class="muted">เมื่อครูเพิ่มไฟล์จริง จะดาวน์โหลดจากหน้านี้และหน้าบทเรียนได้</p><a class="text-link" href={`/classes/${g}/`}>อ่านบทเรียนและฝึกกิจกรรมก่อน →</a></section>)}</div></div></Layout>
