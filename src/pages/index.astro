---
import Layout from '../layouts/Layout.astro';
import {getCollection} from 'astro:content';
const lessons=(await getCollection('lessons')).sort((a,b)=>a.data.grade-b.data.grade||a.data.order-b.data.order);
---
<Layout><div class="container"><section class="hero"><div class="hero-copy"><span class="eyebrow">HELLO, LITTLE EXPLORERS!</span><h1>โลกของคอมพิวเตอร์<br/>เริ่มต้น<span>ที่ห้องเรียนของเรา</span></h1><p>เรียนรู้ทีละขั้น สนุกกับการลงมือทำ<br/>อ่านบทเรียน ดูตัวอย่าง แล้วสร้างผลงานในแบบของตัวเอง</p><a class="button" href="#choose">เลือกชั้นเรียน <span>↗</span></a><div class="hero-note"><span class="dot"></span> เรียนได้ทุกที่ ทบทวนได้ทุกเวลา</div></div><div class="hero-art"><span class="floating top">✦ มาเรียนรู้ด้วยกัน!</span><img src="/images/computer.svg" alt="ภาพคอมพิวเตอร์พร้อมหน้าต่างเขียนโค้ด หนังสือ และเครื่องหมายถูก" width="520" height="360"/><span class="floating bottom">💡 ความรู้ใหม่ ๆ รออยู่</span></div></section><section id="choose" class="section"><div class="section-head"><div><span class="eyebrow">YOUR CLASSROOM</span><h2>วันนี้เราเรียนชั้นไหน?</h2><p>เลือกห้องเรียนของเรา แล้วมาเริ่มเรียนกันเลย</p></div><a class="text-link" href="/classes/">ดูทุกชั้นเรียน ↗</a></div><div class="grade-grid">{[4,5].map((grade)=><a href={`/classes/${grade}/`} class:list={['grade-card',grade===5?'green':'blue']}><span class="grade-icon">{grade===4?'🖥️':'🚀'}</span><div><span class="pill">ห้องเรียนของเรา</span><h3>ประถมศึกษาปีที่ {grade}</h3><p>{grade===4?'รู้จักคอมพิวเตอร์ สร้างสรรค์ผลงาน':'ค้นหาข้อมูล เรียนรู้เทคโนโลยี'}</p></div><span class="circle-arrow">↗</span></a>)}</div></section><section class="steps"><div><span>01</span><div><strong>เลือกบทเรียน</strong><p>เริ่มจากเรื่องที่ครูกำหนด</p></div></div><div><span>02</span><div><strong>เรียนรู้และลองทำ</strong><p>อ่าน ดูตัวอย่าง ฝึกทีละขั้น</p></div></div><div><span>03</span><div><strong>สร้างผลงานของเรา</strong><p>นำความรู้ไปใช้ด้วยตัวเอง</p></div></div></section><section class="section"><div class="section-head"><div><span class="eyebrow">LET’S LEARN SOMETHING NEW</span><h2>บทเรียนพร้อมให้ลองเรียน <span class="spark">✦</span></h2></div><a class="text-link" href="/classes/">ดูบทเรียนทั้งหมด ↗</a></div><div class="lesson-grid">{lessons.map(l=><a class="lesson-card" href={`/lessons/${l.id}/`}><div class:list={['lesson-cover',l.data.grade===4?'lavender':'mint']}><span>{l.data.icon}</span><b>ป.{l.data.grade}</b></div><div class="lesson-body"><small>บทที่ {l.data.order} · {l.data.duration} นาที</small><h3>{l.data.title}</h3><p>{l.data.description}</p><span class="lesson-link">เข้าเรียน <span>→</span></span></div></a>)}</div></section><section class="welcome"><span>🌱</span><div><h2>ค่อย ๆ เรียนรู้ เติบโตไปด้วยกัน</h2><p>ไม่ต้องเก่งตั้งแต่เริ่ม แค่กล้าลองทำ ก็ได้เรียนรู้สิ่งใหม่แล้ว</p></div><a class="text-link" href="/about/">รู้จักห้องเรียนของเรา ↗</a></section></div></Layout>
