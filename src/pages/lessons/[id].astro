---
import Layout from '../../layouts/Layout.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('lessons')).map(lesson=>({params:{id:lesson.id},props:{lesson}}));}
const {lesson}=Astro.props;
const {Content}=await render(lesson);
const siblings=(await getCollection('lessons')).filter(l=>l.data.grade===lesson.data.grade).sort((a,b)=>a.data.order-b.data.order);
const index=siblings.findIndex(l=>l.id===lesson.id);const previous=siblings[index-1];const next=siblings[index+1];
---
<Layout title={lesson.data.title} active="classes"><div class="container page"><div class="breadcrumb"><a href="/">หน้าแรก</a> / <a href={`/classes/${lesson.data.grade}/`}>ป.{lesson.data.grade}</a> / บทที่ {lesson.data.order}</div><div class="learning-layout"><aside class="sidebar"><a class="sidebar-heading" href={`/classes/${lesson.data.grade}/`}>📚 ชั้นประถมศึกษาปีที่ {lesson.data.grade}</a><details open><summary>รายการบทเรียน</summary><nav aria-label="บทเรียนในชั้น">{siblings.map(l=><a class:list={{selected:l.id===lesson.id}} aria-current={l.id===lesson.id?'page':undefined} href={`/lessons/${l.id}/`}><span>{l.data.order}</span>{l.data.title}</a>)}</nav></details><div class="sidebar-tip">💡<strong>เรียนรู้ในจังหวะของตัวเอง</strong><p>อ่านไม่ทัน กลับมาทบทวนได้เสมอ</p></div></aside><article><div class="lesson-heading"><span class="pill">ป.{lesson.data.grade} · บทที่ {lesson.data.order} · {lesson.data.duration} นาที</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p></div><section class="objectives"><h2>🎯 เรียนแล้วเราจะทำอะไรได้?</h2><ul>{lesson.data.objectives.map(o=><li>{o}</li>)}</ul></section><div class="prose"><Content/></div><section class="download-box"><span>📄</span><div><h2>ใบงานประกอบบทเรียน</h2><p>กำลังเตรียมไฟล์ Word / PDF สำหรับบทเรียนนี้</p><small>ระหว่างนี้สามารถฝึกกิจกรรมในบทเรียนตามคำแนะนำของครูได้</small></div></section><div class="lesson-pagination">{previous?<a class="button secondary" href={`/lessons/${previous.id}/`}>← บทก่อนหน้า</a>:<a class="button secondary" href={`/classes/${lesson.data.grade}/`}>← กลับหน้าชั้นเรียน</a>}{next?<a class="button" href={`/lessons/${next.id}/`}>บทถัดไป →</a>:<a class="button" href="/classes/">เลือกชั้นเรียน →</a>}</div></article></div></div></Layout>
